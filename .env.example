# ── Required ────────────────────────────────────────────────────────────────
THREADS_APP_ID=your_meta_app_id
THREADS_APP_SECRET=your_meta_app_secret
THREADS_USER_ID=
OPENROUTER_API_KEY=your_openrouter_api_key
TYPESAFE_API_KEY=your_typesafe_api_key

# ── First-run only (SQLite takes over after auth) ────────────────────────────
# THREADS_ACCESS_TOKEN=your_initial_long_lived_token

# ── Optional ─────────────────────────────────────────────────────────────────
THREADS_REDIRECT_URI=https://localhost/callback
OPENROUTER_MODEL=anthropic/claude-opus-4-6
# Point at a self-hosted/OpenAI-compatible endpoint (e.g. 9router) instead of OpenRouter.
# LLM_API_KEY/LLM_MODEL override OPENROUTER_API_KEY/OPENROUTER_MODEL when set.
# LLM_BASE_URL=http://your-9router-host/v1
# LLM_API_KEY=your_9router_key
# LLM_MODEL=your_9router_model
# JEV evaluates the final caption before publish. Rejected captions are regenerated.
# Keep enabled in production; disable only when intentionally bypassing the quality gate.
JEV_ENABLED=true
# Composite quality score from 0 to 1. Calibrate from your own post results.
JEV_MIN_SCORE=0.65
SEARCH_QUERIES=trending,viral,lagi rame,Indonesia,startup,bisnis,career,creator,web3,tech,DeFi,hackathon,solidity,gaming blockchain,freelance developer,remote work,gaji developer,open source,AI tools,crypto trading,kuliner Jakarta,makanan viral,food recommendation
# Comma-separated personal-account boundaries. Matching queries, sources, and drafts are rejected.
EXCLUDED_TOPICS=Arbitrum
MIN_SOURCE_POSTS=10
MIN_SOURCE_QUERIES=3
MAX_SOURCE_POSTS_PER_QUERY=4
# Peak viewer window measured from Threads Insights is 13:00-16:00 local.
# One slot while reach recovers; add 20:15 back once per-post views pass ~100.
# Threads topic tag per CATEGORY_QUERIES bucket. The post is tagged with the tag of
# the category that contributed most of the crawl, which is how it reaches the topic
# feeds instead of only followers. Each tag is 1-50 chars, no "." or "&".
# TOPIC_TAGS={"tech":"Tech Threads","karir":"Karir","duit":"Keuangan"}
# DEFAULT_TOPIC_TAG=Indonesia
POST_TIMES=13:30
TIMEZONE=Asia/Jakarta
UNSPLASH_ACCESS_KEY=your_unsplash_access_key
# Optional: tell the LLM about you / your projects. Auto-suppressed once your
# project name shows up in 2+ of the last 10 posts, so it doesn't dominate the feed.
# AUTHOR_CONTEXT=I build MyApp — a tool that does X.
DRY_RUN=false
DB_PATH=data/state.db
LOG_LEVEL=info
